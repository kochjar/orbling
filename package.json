{
  "name": "orbling",
  "version": "0.1.0",
  "description": "An open-source orb for AI chat interfaces. One React component.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/orbling.js",
  "module": "./dist/orbling.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/orbling.js"
    },
    "./style.css": "./dist/orbling.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode lib && tsc -p tsconfig.lib.json",
    "build:demo": "node scripts/registry.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "registry": "node scripts/registry.mjs"
  },
  "keywords": [
    "react",
    "orb",
    "ai",
    "avatar",
    "animation",
    "assistant",
    "loader"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.82"
  },
  "devDependencies": {
    "@radix-ui/react-tabs": "^1.2.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
